# Variables de Entorno para Turso Cloud Database
# Copia este archivo como .env para desarrollo local o agrégalas en las variables de entorno de Vercel

PORT=3000

# URL de la base de datos Turso (ejemplo: libsql://movers-db-tuusuario.turso.io)
TURSO_DATABASE_URL=

# Token de autenticación de Turso
TURSO_AUTH_TOKEN=
